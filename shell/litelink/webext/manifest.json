{
  "manifest_version": 3,
  "key": "",
  "name": "LiteLink Kiosk",
  "version": "1.3.0",
  "description": "LiteLink web session rules (allowed sites, reset after a period of no use) and, in LiteOS sessions, window.LiteLink.",
  "permissions": [
    "declarativeNetRequest",
    "idle",
    "browsingData",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
