# LiteLink OS - Openbox theme. Matches the shell: white title bars, ink text,
# blue accents, no gradients. Used for windowed remote sessions and anything
# Openbox draws itself (alerts, menus, on-screen popups).

border.width: 1
padding.width: 10
padding.height: 7
window.handle.width: 0
window.client.padding.width: 0
window.client.padding.height: 0
menu.overlap: 0

window.active.border.color: #C9CED6
window.inactive.border.color: #E1E4E9
window.active.client.color: #FFFFFF
window.inactive.client.color: #FFFFFF

window.active.title.bg: flat solid
window.active.title.bg.color: #FFFFFF
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #F6F7F9
window.active.title.separator.color: #ECEEF2
window.inactive.title.separator.color: #ECEEF2

window.active.label.bg: parentrelative
window.active.label.text.color: #16171A
window.inactive.label.bg: parentrelative
window.inactive.label.text.color: #8A8F98
window.label.text.justify: left

window.active.button.unpressed.bg: parentrelative
window.active.button.unpressed.image.color: #5A606B
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #EEF3FB
window.active.button.hover.image.color: #2659B3
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #E7EFFB
window.active.button.pressed.image.color: #2659B3
window.active.button.disabled.bg: parentrelative
window.active.button.disabled.image.color: #C9CED6
window.active.button.toggled.unpressed.bg: parentrelative
window.active.button.toggled.unpressed.image.color: #2659B3
window.active.button.toggled.hover.bg: flat solid
window.active.button.toggled.hover.bg.color: #EEF3FB
window.active.button.toggled.hover.image.color: #2659B3
window.active.button.toggled.pressed.bg: flat solid
window.active.button.toggled.pressed.bg.color: #E7EFFB
window.active.button.toggled.pressed.image.color: #2659B3

window.inactive.button.unpressed.bg: parentrelative
window.inactive.button.unpressed.image.color: #A3A8B0
window.inactive.button.hover.bg: flat solid
window.inactive.button.hover.bg.color: #EEF3FB
window.inactive.button.hover.image.color: #2659B3
window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #E7EFFB
window.inactive.button.pressed.image.color: #2659B3
window.inactive.button.disabled.bg: parentrelative
window.inactive.button.disabled.image.color: #E1E4E9
window.inactive.button.toggled.unpressed.bg: parentrelative
window.inactive.button.toggled.unpressed.image.color: #A3A8B0

menu.border.width: 1
menu.border.color: #D5D9E0
menu.separator.color: #ECEEF2
menu.separator.padding.width: 6
menu.separator.padding.height: 4
menu.title.bg: flat solid
menu.title.bg.color: #2F6FD6
menu.title.text.color: #FFFFFF
menu.title.text.justify: left
menu.items.bg: flat solid
menu.items.bg.color: #FFFFFF
menu.items.text.color: #16171A
menu.items.disabled.text.color: #A3A8B0
menu.items.active.bg: flat solid
menu.items.active.bg.color: #F2F5FA
menu.items.active.text.color: #2659B3

osd.border.width: 1
osd.border.color: #D5D9E0
osd.bg: flat solid
osd.bg.color: #FFFFFF
osd.label.bg: parentrelative
osd.label.text.color: #16171A
osd.hilight.bg: flat solid
osd.hilight.bg.color: #2F6FD6
osd.unhilight.bg: flat solid
osd.unhilight.bg.color: #E1E4E9
osd.button.unpressed.bg: flat solid
osd.button.unpressed.bg.color: #FFFFFF
osd.button.unpressed.box.color: #C9CED6
osd.button.pressed.bg: flat solid
osd.button.pressed.bg.color: #E7EFFB
osd.button.pressed.box.color: #2F6FD6
osd.button.focused.bg: flat solid
osd.button.focused.bg.color: #2F6FD6
osd.button.focused.box.color: #2F6FD6
osd.button.focused.text.color: #FFFFFF
