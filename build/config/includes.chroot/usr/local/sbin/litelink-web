#!/usr/bin/python3
"""LiteLink OS: browser permissions for a LiteOS session (run as root via sudo by the shell).

  litelink-web grant ORIGIN    let ORIGIN (a LiteOS instance) use what the web
                               platform otherwise asks for, without prompts
  litelink-web clear           remove those grants
  litelink-web certs           trust the certificate authorities given on stdin
                               (a JSON list of PEM certificates; [] removes them all)
  litelink-web print on|off    allow Chromium's own printing for the next session
                               (on: a LiteOS connection with Printers on, print module
                               installed; off for every other session)

Chromium runs in kiosk mode, where permission prompts can't be answered (they
hang off the address bar, which kiosk mode doesn't have), so a LiteOS app asking
to read the clipboard (Docs, Sheets: Ctrl+V), notify or use the camera is simply
refused. The shell calls `grant` with the LiteOS address right before starting
Chromium, only when the address identified itself as LiteOS
(<meta name="application-name" content="LiteOS">); ordinary sites get nothing.

The grants are a Chromium managed-policy file, read when Chromium starts:
/etc/chromium/policies/managed/litelink-liteos.json. The device-wide rules stay
in litelink.json next to it.
"""
import json
import os
import re
import sys

POLICY = "/etc/chromium/policies/managed/litelink-liteos.json"
# scheme://host[:port], host = DNS name or IPv4 (what LiteLink connects LiteOS by)
ORIGIN = re.compile(r"^(https?)://([a-z0-9]([a-z0-9-]*[a-z0-9])?(\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)*"
                    r"|\d{1,3}(\.\d{1,3}){3})(:\d{1,5})?$")

# Per-site "allow" policies: the LiteOS origin is added to each list
ALLOW_LISTS = [
    "ClipboardAllowedForUrls",          # read the clipboard (paste in Docs, Sheets, Slides…)
    "NotificationsAllowedForUrls",      # LiteOS notifications
    "AudioCaptureAllowedUrls",          # microphone
    "VideoCaptureAllowedUrls",          # camera
    "AutoplayAllowlist",                # media plays without a click first
    "PopupsAllowedForUrls",             # windows opened by LiteOS apps
    "CookiesAllowedForUrls",            # incl. third-party cookies inside LiteOS (sign-ins in framed sites)
    "WindowManagementAllowedForUrls",   # multi-screen window placement
    "LocalFontsAllowedForUrls",         # the device's fonts (Docs font list)
    "IdleDetectionAllowedForUrls",      # "away" detection
    "SensorsAllowedForUrls",            # motion sensors
    "SerialAllowAllPortsForUrls",       # serial devices (scales, card readers)
    "WebHidAllowAllDevicesForUrls",     # HID devices (signature pads, barcode readers)
]


def grant(origin):
    origin = origin.strip().rstrip("/").lower()
    if not ORIGIN.match(origin):
        raise SystemExit(f"not an origin: {origin!r} (scheme://host[:port])")
    policy = {name: [origin] for name in ALLOW_LISTS}
    os.makedirs(os.path.dirname(POLICY), exist_ok=True)
    tmp = POLICY + ".tmp"
    with open(tmp, "w") as f:
        json.dump(policy, f, indent=1)
    os.chmod(tmp, 0o644)
    os.replace(tmp, POLICY)


def clear():
    try:
        os.remove(POLICY)
    except FileNotFoundError:
        pass


CERTS_POLICY = "/etc/chromium/policies/managed/litelink-certs.json"
CERTS_DIR = "/usr/local/share/ca-certificates/litelink"


def certs():
    """Settings › Certificates: certificate authorities of the organisation's own
    (a LiteOS server on the LAN, a company CA). Chromium trusts them through its
    CACertificates policy (it doesn't read the system store on Linux); everything
    else that checks TLS on the device (the device bridge, OpenSSL) through the
    system store. Certificates arrive on stdin, never as paths, so this can't be
    pointed at other files."""
    import base64
    import ssl
    import subprocess
    import tempfile
    pems = json.load(sys.stdin)
    if not isinstance(pems, list) or len(pems) > 50:
        raise SystemExit("expected a list of at most 50 PEM certificates")
    ders = []
    for pem in pems:
        if not isinstance(pem, str) or len(pem) > 20000:
            raise SystemExit("not a PEM certificate")
        try:
            der = ssl.PEM_cert_to_DER_cert(pem)
            with tempfile.NamedTemporaryFile("w", suffix=".pem") as f:     # parses as a certificate?
                f.write(ssl.DER_cert_to_PEM_cert(der))
                f.flush()
                ssl._ssl._test_decode_cert(f.name)
        except (ValueError, ssl.SSLError, OSError):
            raise SystemExit("not a certificate")
        ders.append(der)
    os.makedirs(os.path.dirname(CERTS_POLICY), exist_ok=True)
    if ders:
        tmp = CERTS_POLICY + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"CACertificates": [base64.b64encode(d).decode() for d in ders]}, f, indent=1)
        os.chmod(tmp, 0o644)
        os.replace(tmp, CERTS_POLICY)
    else:
        try:
            os.remove(CERTS_POLICY)
        except FileNotFoundError:
            pass
    os.makedirs(CERTS_DIR, mode=0o755, exist_ok=True)
    for name in os.listdir(CERTS_DIR):
        os.remove(os.path.join(CERTS_DIR, name))
    for i, der in enumerate(ders):
        path = os.path.join(CERTS_DIR, f"litelink-{i + 1}.crt")
        with open(path, "w") as f:
            f.write(ssl.DER_cert_to_PEM_cert(der))
        os.chmod(path, 0o644)
    if os.path.exists("/usr/sbin/update-ca-certificates"):
        subprocess.run(["/usr/sbin/update-ca-certificates", "--fresh"], capture_output=True)


PRINT_POLICY = "/etc/chromium/policies/managed/litelink-print.json"


def printing(on):
    """PrintingEnabled is one device-wide switch, so it has a file of its own,
    rewritten before every session (off in the image). Only the printers in
    Settings › Printers are offered: no Save as PDF (downloads are off in the
    kiosk) and no extension or network-discovered destinations."""
    tmp = PRINT_POLICY + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"PrintingEnabled": on, "PrinterTypeDenyList": ["pdf", "extension", "privet", "cloud"]}, f, indent=1)
    os.chmod(tmp, 0o644)
    os.replace(tmp, PRINT_POLICY)


def main(argv):
    if len(argv) == 3 and argv[1] == "print" and argv[2] in ("on", "off"):
        printing(argv[2] == "on")
        return
    if len(argv) == 2 and argv[1] == "certs":
        certs()
        return
    if len(argv) == 3 and argv[1] == "grant":
        grant(argv[2])
    elif len(argv) == 2 and argv[1] == "clear":
        clear()
    else:
        raise SystemExit(__doc__)


if __name__ == "__main__":
    main(sys.argv)
