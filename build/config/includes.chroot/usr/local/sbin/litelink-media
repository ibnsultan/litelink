#!/usr/bin/python3
"""LiteLink OS: access to USB drives (run as root via sudo by the shell).

  litelink-media list             JSON: USB drive partitions LiteLink can read
  litelink-media mount DEV [--rw|--ro]  mount DEV read-only (or writable), print the mount point;
                                  an existing mount is switched to writable (--rw) or back (--ro)
  litelink-media eject DEV        write everything out and unmount DEV, refusing (exit 3)
                                  while it's in use, so "safe to pull out" is true
  litelink-media unmount [DEV]    unmount DEV (or every drive mounted here)
  litelink-media save DEV NAME    write stdin to the file NAME on DEV (Diagnostics report)

Used to bring files in (e.g. a WireGuard .conf). Only USB / removable drives with
FAT32, exFAT or NTFS are offered, never the LiteLink boot stick or the internal
disk. Mounts are read-only with nosuid,nodev,noexec, owned by the litelink user
so the shell can read them, and live under /run/litelink/media.
"""
import json
import os
import re
import subprocess
import sys

MEDIUM = "/run/live/medium"
ROOT = "/run/litelink/media"
USER_UID = USER_GID = 1000
DRIVERS = {"vfat": "vfat", "exfat": "exfat", "ntfs": "ntfs3", "ntfs3": "ntfs3"}
OUR_LABELS = {"LITELINK", "litelink-data", "litelink-usb", "LLEFI"}


def out(*cmd):
    r = subprocess.run(cmd, capture_output=True, text=True)
    return r.stdout.strip() if r.returncode == 0 else ""


def tree():
    data = json.loads(out("lsblk", "-J", "-b", "-o",
                          "NAME,PATH,SIZE,TYPE,TRAN,MODEL,VENDOR,RM,HOTPLUG,LABEL,FSTYPE,MOUNTPOINT")
                      or '{"blockdevices": []}')
    return data.get("blockdevices", [])


def boot_disk():
    src = out("findmnt", "-no", "SOURCE", MEDIUM)
    if not src:
        return None
    parent = out("lsblk", "-no", "PKNAME", src)
    return f"/dev/{parent.splitlines()[0]}" if parent else src


def drives():
    """Readable partitions on USB drives: [{path, label, fstype, size, drive, mountpoint}]"""
    boot = boot_disk()
    found = []
    for disk in tree():
        if disk.get("type") != "disk" or disk.get("path") == boot:
            continue
        if not (disk.get("tran") == "usb" or disk.get("rm") or disk.get("hotplug")):
            continue
        name = " ".join(x.strip() for x in (disk.get("vendor") or "", disk.get("model") or "") if x and x.strip())
        for p in disk.get("children") or [disk]:
            fs = p.get("fstype")
            if fs not in DRIVERS or (p.get("label") or "") in OUR_LABELS:
                continue
            mp = p.get("mountpoint") or ""
            found.append({"path": p["path"], "label": p.get("label") or "", "fstype": fs,
                          "size": p.get("size") or 0, "drive": name or "USB drive",
                          "mountpoint": mp if mp.startswith(ROOT + "/") else ""})
    return found


def target(dev):
    return os.path.join(ROOT, re.sub(r"[^A-Za-z0-9_-]", "_", os.path.basename(dev)))


def mount_options(fstype, rw):
    opts = f"{'rw' if rw else 'ro'},nosuid,nodev,noexec,uid={USER_UID},gid={USER_GID},umask=022"
    if rw and fstype == "vfat":
        opts += ",flush"            # FAT: write data out promptly, so a stick pulled out loses little
    return opts


def cmd_mount(dev, rw=False, ro=False):
    """Read-only by default; --rw for a LiteOS session allowed to write, only
    while it writes ("USB drives: Read and write"); --ro switches it back once
    the writing is done (a FAT drive is marked in use while mounted writable).
    Still nosuid,nodev,noexec, owned by the litelink user."""
    d = next((x for x in drives() if x["path"] == dev), None)
    if not d:
        raise RuntimeError("not a readable USB drive")
    if d["mountpoint"]:
        mp = d["mountpoint"]
        readonly = bool(os.statvfs(mp).f_flag & os.ST_RDONLY)
        if (rw and readonly) or (ro and not readonly):
            subprocess.run(["sync"])
            r = subprocess.run(["mount", "-o", "remount," + mount_options(d["fstype"], rw), mp],
                               capture_output=True, text=True)
            if r.returncode != 0:
                raise RuntimeError((r.stderr or "remount failed").strip()[:200])
        return mp
    mp = target(dev)
    os.makedirs(mp, mode=0o755, exist_ok=True)
    opts = mount_options(d["fstype"], rw)
    r = subprocess.run(["mount", "-t", DRIVERS[d["fstype"]], "-o", opts, dev, mp],
                       capture_output=True, text=True)
    if r.returncode != 0:
        try:
            os.rmdir(mp)
        except OSError:
            pass
        raise RuntimeError((r.stderr or "mount failed").strip()[:200])
    return mp


def cmd_unmount(dev=None):
    if not os.path.isdir(ROOT):
        return
    targets = [target(dev)] if dev else [os.path.join(ROOT, n) for n in os.listdir(ROOT)]
    subprocess.run(["sync"])
    for mp in targets:
        if os.path.ismount(mp):
            # a plain unmount writes everything out first (safe to pull the drive out);
            # lazy only when that fails: a drive already pulled out, or still busy
            if subprocess.run(["umount", mp], capture_output=True).returncode != 0:
                subprocess.run(["umount", "-l", mp], capture_output=True)
        try:
            os.rmdir(mp)
        except OSError:
            pass


def cmd_eject(dev):
    """Write everything out and unmount, never lazily: exit 3 while something
    still has a file open on it, so the caller doesn't say it's safe when it isn't."""
    subprocess.run(["sync"])
    mp = target(dev)
    if os.path.ismount(mp):
        r = subprocess.run(["umount", mp], capture_output=True, text=True)
        if r.returncode != 0:
            print("ERROR busy", file=sys.stderr)
            return 3
    try:
        os.rmdir(mp)
    except OSError:
        pass
    return 0


def cmd_save(dev, name):
    """Write a small text file (stdin) to the top folder of a USB drive. The
    drive is mounted writable only for the copy, then unmounted again (synced:
    it's safe to pull out afterwards). The file is read from
    stdin (never a path), so this can't copy files from the system."""
    if not re.fullmatch(r"[A-Za-z0-9._-]{1,80}", name) or name.startswith("."):
        raise RuntimeError("invalid file name")
    data = sys.stdin.buffer.read(5 * 1024 * 1024 + 1)
    if len(data) > 5 * 1024 * 1024:
        raise RuntimeError("file too large")
    d = next((x for x in drives() if x["path"] == dev), None)
    if not d:
        raise RuntimeError("not a USB drive")
    if d["mountpoint"]:                 # one mount per device: drop the read-only one first
        cmd_unmount(dev)
    mp = target(dev) + "-rw"
    os.makedirs(mp, mode=0o755, exist_ok=True)
    opts = f"rw,nosuid,nodev,noexec,uid={USER_UID},gid={USER_GID},umask=022"
    r = subprocess.run(["mount", "-t", DRIVERS[d["fstype"]], "-o", opts, dev, mp], capture_output=True, text=True)
    if r.returncode != 0:
        os.rmdir(mp)
        raise RuntimeError((r.stderr or "mount failed").strip()[:200])
    try:
        with open(os.path.join(mp, name), "wb") as f:
            f.write(data)
    finally:
        subprocess.run(["sync"])
        subprocess.run(["umount", mp], capture_output=True)
        try:
            os.rmdir(mp)
        except OSError:
            pass


def main():
    args = sys.argv[1:]
    try:
        if args == ["list"]:
            print(json.dumps(drives()))
        elif len(args) == 2 and args[0] == "mount":
            print(cmd_mount(args[1]))
        elif len(args) == 3 and args[0] == "mount" and args[2] in ("--rw", "--ro"):
            print(cmd_mount(args[1], rw=args[2] == "--rw", ro=args[2] == "--ro"))
        elif len(args) == 2 and args[0] == "eject":
            return cmd_eject(args[1])
        elif args and args[0] == "unmount" and len(args) <= 2:
            cmd_unmount(args[1] if len(args) == 2 else None)
        elif len(args) == 3 and args[0] == "save":
            cmd_save(args[1], args[2])
        else:
            print(__doc__, file=sys.stderr)
            return 2
    except Exception as e:  # noqa: BLE001 - reported to the UI
        print(f"ERROR {e}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
